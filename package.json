{
  "name": "remote-agent-workbench",
  "version": "0.1.0",
  "description": "A local-first workbench for running AI coding tasks through isolated worktrees, review gates, verification, and local commits.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "codex",
    "claude-code",
    "ai-agents",
    "coding-agents",
    "developer-tools",
    "git-worktree",
    "local-first",
    "agent-orchestration",
    "workflow-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sebstain9/remote-agent-workbench.git"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "public-scan": "node scripts/public-scan.mjs",
    "build": "npm run typecheck && vite build",
    "verify": "npm run typecheck && npm test && npm run public-scan && npm run build",
    "start": "NODE_ENV=production tsx src/server/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^4.22.1",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
